import speech_recognition as sr
import pyttsx3
from googletrans import Translator

LANGUAGES = {
"1": ("Hindi", "hi"),
"2": ("Tamil", "ta"),
"3": ("Telugu", "te"),
"4": ("Bengali", "bn"),
"5": ("Marathi", "mr"),
"6": ("Gujarati", "gu"),
"7": ("Malayalam", "ml"),
"8": ("Punjabi", "pa"),
}

translator = Translator()

def speak(text):
voice = pyttsx3.init()
voice.setProperty("rate", 145)
voice.setProperty("volume", 0.9)
voice.say(text)
voice.runAndWait()
voice.stop()

def listen():
recognizer = sr.Recognizer()

with sr.Microphone() as source:
    print("\n🎙️ Listening... Please speak in English.")
    recognizer.adjust_for_ambient_noise(source, duration=0.5)

    try:
        audio = recognizer.listen(source, timeout=7, phrase_time_limit=12)
    except sr.WaitTimeoutError:
        print("⏰ Listening timed out.")
        return ""

try:
    print("🔎 Converting speech to text...")
    result = recognizer.recognize_google(audio, language="en-US")
    print(f"📝 Detected: {result}")
    return result

except sr.UnknownValueError:
    print("❌ I couldn't understand the speech.")
except sr.RequestError as error:
    print(f"❌ Recognition service error: {error}")

return ""

def choose_language():
print("\n🌐 TARGET LANGUAGES")
print("-" * 32)

for number, (language, code) in LANGUAGES.items():
    print(f"{number}) {language} - {code}")

print("-" * 32)

selection = input("Select a language (1-8): ").strip()

return LANGUAGES.get(selection, ("Hindi", "hi"))

def translate(text, language_code):
try:
output = translator.translate(text, dest=language_code)
return output.text
except Exception as error:
print(f"❌ Translation failed: {error}")
return ""

def translate_once():
language_name, language_code = choose_language()

print(f"\n🎯 Translating English → {language_name}")
input("Press Enter to start speaking...")

english_text = listen()

if not english_text:
    return

translated = translate(english_text, language_code)

if not translated:
    return

print("\n" + "=" * 45)
print("        ✨ TRANSLATION RESULT")
print("=" * 45)
print(f"🇬🇧 English : {english_text}")
print(f"🌍 {language_name} : {translated}")
print("=" * 45)

print("\n🔊 Playing translated voice...")
speak(translated)
print("✅ Done!")

def main():
print("\n╔══════════════════════════════════════╗")
print("║       🌍 SMART VOICE TRANSLATOR     ║")
print("╚══════════════════════════════════════╝")

speak("Welcome to Smart Voice Translator")

while True:
    print("\n📌 MAIN MENU")
    print("1. 🎤 Translate Voice")
    print("2. 🔊 Voice Demo")
    print("3. 🚪 Close Translator")

    option = input("\nEnter your choice: ").strip()

    if option == "1":
        translate_once()

        again = input("\n🔁 Translate again? (y/n): ").strip().lower()

        if again != "y":
            print("Returning to main menu...")

    elif option == "2":
        speak("Hello! This is your smart voice translator.")

    elif option == "3":
        print("\n👋 Translator closed. Have a great day!")
        speak("Goodbye!")
        break

    else:
        print("⚠️ Please enter 1, 2, or 3.")

